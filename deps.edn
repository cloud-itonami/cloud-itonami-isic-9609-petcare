;; `resources/` carries the vendored jp-go-digital-design-system CSS
;; (デジタル庁デザインシステム, MIT) that `petcare.render-html` inlines into
;; docs/samples/operator-console.html. It is checked in rather than pulled
;; as a :git/dep on purpose: a standalone fork of this repo must be able to
;; regenerate the console with no network at all, which is the same
;; forkability claim the comment below makes about langgraph.
{:paths ["src" "resources"]
 ;; langgraph brings langchain transitively (both zero-/single-dep, all
 ;; .cljc -> portable to JVM / SCI / ClojureScript). It lives in the
 ;; kotoba-lang org of this workspace. This repo is standalone
 ;; (forkable outside the workspace); the :local/root paths only resolve
 ;; inside the monorepo checkout — a standalone fork should override
 ;; them with git coordinates.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}
 :aliases
 {:dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "petcare.sim"]}
  ;; kbb -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by RUNNING the real actor.
  ;; The build throws rather than writing a page when the run produces no
  ;; governor hold, when a declared governor rule never fires, or when the
  ;; approver join measures nothing (flagship checklist item 2).
  :render-html {:main-opts ["-m" "petcare.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
